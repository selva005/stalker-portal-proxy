# Stalker-Portal host, e.g. example.com (no http:// prefix)
STALKER_HOST=

# MAC address of the device, e.g. 00:1A:79:XX:XX:XX
STALKER_MAC=

# Serial number
STALKER_SERIAL=

# Device ID
STALKER_DEVICE_ID=

# Device ID 2
STALKER_DEVICE_ID2=

# STB type (default: MAG250)
STALKER_STB_TYPE=MAG250

# API signature (default: 263, rarely needs changing)
STALKER_API_SIGNATURE=263

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Comma-separated, case-insensitive substrings to hide from live TV genre,
# VOD category, and series category listings (e.g. ADULT,XXX). Leave empty for no filtering.
BLOCKED_CATEGORY_NAMES=

# How long (seconds) to cache genre/category/channel/VOD/series listing responses
# before re-fetching from the portal. Reduces repeated hits from multiple TVs or
# app refreshes. Does not apply to stream links (create_link) or EPG. Also controls
# how often the background auto-sync re-runs. Default: 21600 (6 hours).
LISTING_CACHE_TTL_SECONDS=21600

# Delay (seconds) between each request during background auto-sync, to avoid
# hammering the portal. Default: 0.3
PREWARM_DELAY_SECONDS=0.3

# How many pages of each VOD/series category to auto-sync in the background.
# Full catalogs are too large to sync entirely (tens of thousands of items per
# category); this covers the first few pages only. Default: 3
PREWARM_VOD_SERIES_PAGES=3

# How long (seconds) to back off after a rate-limit (429) response during background
# auto-sync, before the next request. Default: 30
PREWARM_RATE_LIMIT_BACKOFF_SECONDS=30

# Abort the current crawl cycle after this many consecutive rate-limit (429) responses,
# publishing whatever was gathered so far rather than continuing to hammer a portal
# that's actively throttling this account. Default: 5
PREWARM_MAX_CONSECUTIVE_RATE_LIMITS=5

# Path (inside the container) where the listing cache is persisted to disk, so a
# container restart doesn't start cold. Should be under a mounted volume (see
# docker-compose.yml). Default: /data/cache.json
CACHE_FILE_PATH=/data/cache.json

# Path (inside the container) where the generated XMLTV guide (/epg.xml) is persisted
# to disk. Should be under a mounted volume. Default: /data/epg.xml
EPG_FILE_PATH=/data/epg.xml

# How many hours of upcoming programming to include per channel in the generated
# XMLTV guide. Default: 24
EPG_HOURS=24

# Publish partial EPG results every N channels during the background crawl, instead
# of waiting for all channels to finish (a full crawl can take 30-60+ minutes on large
# channel lists). Default: 200
EPG_PUBLISH_EVERY_N_CHANNELS=200

# How long (seconds) previously-persisted EPG data is considered "fresh" -- if a
# completed crawl finished more recently than this, a container restart skips the
# startup EPG crawl and just serves the persisted data, refreshing later on the normal
# background schedule. Default: same as LISTING_CACHE_TTL_SECONDS.
EPG_FRESHNESS_TTL_SECONDS=21600
